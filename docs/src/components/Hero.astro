---
const { data } = Astro.locals.starlightRoute.entry;
const { title, tagline, actions = [] } = data.hero || {};

const codeLines = [
  { text: 'from openubl import Invoice, signer', cls: 'comment' },
  { text: '', cls: '' },
  { text: 'invoice = Invoice(', cls: '' },
  { text: '    serie="F001",', cls: '' },
  { text: '    numero=1,', cls: '' },
  { text: '    proveedor={"ruc": "20100111111"},', cls: '' },
  { text: '    cliente={"nombre": "Cliente Ejemplo"},', cls: '' },
  { text: '    detalles=[{"descripcion": "Servicio", "cantidad": 1, "precio": 100.00}],', cls: '' },
  { text: '    moneda="PEN",', cls: '' },
  { text: ')', cls: '' },
  { text: '', cls: '' },
  { text: 'xml = invoice.to_xml()', cls: '' },
  { text: 'signed = signer.sign(xml)', cls: '' },
];
---

<div class="hero">
	<div class="hero-glow" aria-hidden="true"></div>
	<div class="hero-inner">
		<div class="hero-copy">
			<span class="hero-eyebrow">openUBL · Python + TypeScript + REST</span>
			<h1>
				{title ? <span class="hero-title-main" set:html={title} /> : <span class="hero-title-main">openUBL</span>}
				<span class="hero-title-sub">XML UBL 2.1 firmado <em>y listo para SUNAT.</em></span>
			</h1>
			{tagline && <p class="hero-tagline" set:html={tagline} />}
			{
				actions.length > 0 && (
					<div class="hero-actions">
						{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => {
							const isGithub = icon?.name === 'github' || text?.toLowerCase().includes('github');
							return (
								<a
									{href}
									class:list={['sl-link-button not-content hero-button', variant, className]}
									{...attrs}
								>
									{isGithub && (
										<svg class="hero-button-icon" viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
											<path
												fill="currentColor"
												d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.419-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
											/>
										</svg>
									)}
									{text}
								</a>
							);
						})}
					</div>
				)
			}
		</div>
		<div class="hero-code" aria-hidden="true">
			<div class="code-window">
				<div class="code-header">
					<span class="code-dot red"></span>
					<span class="code-dot yellow"></span>
					<span class="code-dot green"></span>
					<span class="code-filename">invoice.py</span>
				</div>
				<div class="code-body">
					{codeLines.map((line, index) => (
						<div class="code-line" style={`--delay: ${index}`}>
							{line.text ? (
								line.cls === 'comment' ? (
									<span class="code-comment">{line.text}</span>
								) : (
									<span>{line.text}</span>
								)
							) : (
								<span>&nbsp;</span>
							)}
						</div>
					))}
				</div>
			</div>
		</div>
	</div>
</div>
