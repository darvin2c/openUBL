{
  "name": "@openubl/sdk",
  "version": "0.1.4",
  "description": "TypeScript SDK for openUBL - Peruvian SUNAT Electronic Documents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../openapi.json --output src/openubl-types.ts",
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run generate && npm run build"
  },
  "devDependencies": {
    "openapi-fetch": "^0.9.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "sunat",
    "ubl",
    "facturacion-electronica",
    "peru"
  ]
}
