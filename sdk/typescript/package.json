{
  "name": "@openubl/sdk",
  "version": "0.2.3",
  "description": "TypeScript SDK for openUBL - Peruvian SUNAT Electronic Documents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./zod.gen": {
      "types": "./dist/zod.gen.d.ts",
      "default": "./dist/zod.gen.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "uv run python ../../scripts/export_openapi.py && openapi-ts && npm run generate:version-export",
    "generate:version-export": "node scripts/finalize-index.js",
    "build": "tsc",
    "test": "vitest run",
    "prepublishOnly": "npm run generate && npm run build"
  },
  "dependencies": {
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.98.2",
    "@types/node": "^25.9.3",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "sunat",
    "ubl",
    "facturacion-electronica",
    "peru"
  ]
}
