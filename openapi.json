        "parameters": [
          {
            "in": "query",
            "name": "validate",
            "required": false,
            "schema": {
              "default": true,
              "title": "Validate",
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreditNote"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
